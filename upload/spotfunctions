import spotipy
from spotipy.oauth2 import SpotifyOAuth

scope = (
    "user-read-playback-state "
    "user-modify-playback-state "
    "playlist-read-private "
    "user-library-modify "
    "user-library-read "
)

sp = spotipy.Spotify(
    auth_manager = SpotifyOAuth(
        scope = scope
    )
)

export SPOTIPY_CLIENT_ID = "myid" 
export SPOTIPY_CLIENT_SECRET

def liked_songs():
    lsongs = {}
    results = sp.current_user_saved_tracks()
    while results:
        for item in results["items"]:
            song = item["track"]
            if song is None:
                continue
            else:
                cover_url = song["album"]["images"][0]["url"]
                lsongs[song["name"]] = [song["artists"][0]["name"], song["uri"], cover_url]
        if results["next"]:
            results = sp.ext(results)
        else:
            break
    return lsongs


def playlists():
    userplaylists = {}

    results = sp.current_user_playlists()
    while results:
        for pl in results["items"]:
            userplaylists[pl["name"]] = pl["id"]
        if results["next"]:
            results = sp.next(results)
    return userplaylists

def openplaylist(playlist_id):
    results = sp.playlists_tracks(playlist_id)
    songs = []
    while results:
        for item in results["items"]:
            track = item["track"]
            if track is None:
                continue
            else:
                cover_url = None
                if track["album"]["images"]:
                    cover_url = track["album"]["images"][0]["url"]
                songs.append({
                    "name": track["name"],
                    "artists": track["artists"][0]["name"],
                    "uri": track ["uri"],
                    "cover": cover_url})
        if results["next"]:
            results = sp.next(results)
        else:
            break
    return songs

def play_song(uri):
    sp.start_playback(uris = [uri])

def pause():
    sp.pause_playback()

def resume():
    sp.start_playback()

def next_song():
    sp.next_track()

def previous_song():
    sp.previous_track()

def seek(position):
    sp.seek_track(position)

def rewind(seconds=15):
    playback = sp.current_playback()
    if playback is None:
        return
    position = playback["progress_ms"]
    new_position = max(0, position-(seconds*1000))
    sp.seek_track(new_position)

def forward(seconds = 15):
    playback = sp.current_playback()
    if playback is None:
        return
    position = playback["progress_ms"]
    duration = playback["item"]["duration_ms"]
    if position < duration-(seconds*1000):
        new_position = position + (seconds*1000)
        sp.seek_track(new_position)

def current_song():
    #returns: name, artist, uri, cover, progress, duration, status, none if nothing is playing
    playback = sp.current_playback()
    if playback is None:
        return None
    track = playback.get("item")
    if track is None:
        return None
    cover_url = None
    if track["album"]["images"]:
        cover_url = track["album"]["images"][0]["url"]
    return {"name": track["name"], 
            "artist": track["artists"][0]["name"],
            "uri" : track["uri"],
            "cover": cover_url,
            "progress": playback["progress_ms"],
            "duration": playback["duration_ms"],
            "is_playing": playback["is_playing"]}

def set_volume(volume):
    volume = max(0, min(100, volume))
    sp.volume(volume)

def volume_inc(amount = 5):
    playback = sp.current_playback()
    if playback is None:
        return
    current = playback["device"]["volume_percent"]
    new = min(100, current + amount)
    sp.volume(new)

def volume_dec(amount = 15):
    playback = sp.current_playback()
    if playback is None:
        return
    current = playback["device"]["volume_percent"]
    new = max(0, current-amount)
    sp.volume(new)

def is_playing():
    playback = sp.current_playback()
    if playback is None:
        return False
    else:
        return True

def progress():
    playback = sp.current_playback()
    if playback is None:
        return None
    track = playback.get("item")
    return track["duration_ms"]

def search_song(query, limit=10):
    #should return name, artist, url, cover
    results = sp.search(q = query, type = "track", limit=limit)
    songs = []
    for track in results["tracks"]["items"]:
        coverurl = None
        if track["album"]["images"]:
            coverurl = track["album"]["images"][0]["url"]
        songs.append({"name": track["name"],
                      "artists": track["artists"][0]["name"],
                      "uri": track["uri"]
                      "cover": coverurl})
        return songs







