DEVICE_NAME = os.environ.get("SPOTIFY_DEVICE_NAME", "cirrus")   # must match LIBRESPOT_NAME in /etc/raspotify/conf


def get_device_id():
    """Spotify Connect id of the Pi (raspotify). None if it isn't visible."""
    try:
        devices = sp.devices().get("devices", [])
    except Exception:
        return None
    for d in devices:
        if d["name"].lower() == DEVICE_NAME.lower():
            return d["id"]
    return None


def ensure_device():
    """Make the Pi the active playback device so start_playback() doesn't 404."""
    dev = get_device_id()
    if dev is None:
        return None
    try:
        pb = sp.current_playback()
        if pb is None or pb.get("device", {}).get("id") != dev:
            sp.transfer_playback(dev, force_play=False)
            time.sleep(0.7)
    except Exception:
        pass
    return dev


# Background poller: the UI redraws ~60x/s, so it must never call the Spotify API itself.
_np = {"data": None, "t": 0.0}
_poller_started = False


def _poll_loop():
    while True:
        try:
            pb = sp.current_playback()
            data = None
            if pb and pb.get("item"):
                tr = pb["item"]
                imgs = tr["album"]["images"]
                data = {"name": tr["name"],
                        "artists": tr["artists"][0]["name"],
                        "uri": tr["uri"],
                        "cover": imgs[0]["url"] if imgs else None,
                        "progress": pb.get("progress_ms") or 0,
                        "duration": tr["duration_ms"],
                        "is_playing": pb["is_playing"]}
            _np["data"] = data
            _np["t"] = time.time()
        except Exception:
            pass
        time.sleep(2)


def get_current_song():
    """Non-blocking. Same keys pygamemenu.draw_currently_playing() reads. None if idle."""
    global _poller_started
    if not _poller_started:
        _poller_started = True
        threading.Thread(target=_poll_loop, daemon=True).start()
    d = _np["data"]
    if d is None:
        return None
    d = dict(d)
    if d["is_playing"]:
        d["progress"] = min(d["duration"], d["progress"] + (time.time() - _np["t"]) * 1000)
    return d

