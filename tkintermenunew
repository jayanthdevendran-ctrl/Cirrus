import tkinter as tk
import subprocess
import time
from gpiozero import Button

select = Button(19, bounce_time=0.05)
root = tk.Tk()
root.title("Cirrus.exe")
root.geometry("480x320")

status_frame = tk.Frame(root, width = 480, height = 15)
status_frame.pack(side = "top")

content_frame = tk.Frame(root, width = 480, height = 305)
content_frame.pack(side = "bottom")

history = ["Main"]

def open_music():
        global currentmenu
        history.append("Music")
        currentmenu = menus[-1]
def open_games():
        global currentmenu
        history.append("Games")
        currentmenu = history[-1]
def open_settings():
        global currentmenu
        history.append("settings")
        currentmenu = history[-1]

def poweroff():
        subprocess.run(["sudo", "poweroff"])
def openlikedsongs():
       print("opened like songs")
def openplaylists():
       print("opened playlists")
def opensearch():
       print("opened search")
def goback():
       global currentmenu
       currentmenu = history.pop()
def runDOOM():
        print("opened doom")
def runPSGAME():
       print("opened ps game menu")
def volume():
       print("volume menu")
def backlight():
       print("backlight")

selection = 0

menus = {
    "Main": {
        "Music": open_music,
        "Games": open_games,
        "Settings": open_settings,
        "Power Off": poweroff
    },
    "Music": {
        "Liked Songs": openlikedsongs,
        "Playlists": openplaylists,
        "Search": opensearch,
        "Back": goback
    },
    "Games": {
        "Doom": runDOOM,
        "PS1": runPSGAME,
        "Back": goback
    },
    "Settings": {
            "Volume": volume,
            "Backlight": backlight,
            "Back": goback
       }
}

currentmenu = history[-1]

menu = tk.Listbox(content_frame,
                font = ("georgia", 14),
                highlightcolor = "blue",
                fg = "gray")
menu.pack(side = "left", fill = "both")

def draw_menu():
    menu.delete(0, tk.END)
    for index, item in currentmenu.keys:
        menu.insert(index, item[0])

draw_menu()
def check_selection():
        if select.is_pressed:
                selection = menu.curselection()[0]
                menu.delete(0, tk.END)
                (currentmenu[selection]())
                history.append(currentmenu[selection].key)
                draw_menu()

select.when_pressed = check_selection()
root.mainloop()