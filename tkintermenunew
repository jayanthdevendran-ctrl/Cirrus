import tkinter as tk

root = tk.Tk()

history = [Mainmenu]

class Cirrus(tk.TK):
    def __init__(self):
        super().__init__()
        self.title("Cirrus.exe")
        self.geometry("480x320")
        
        self.status_frame = tk.Frame(self, bg = "gray", height = 20)
        self.status_frame.pack (fill = "x")

        self.content_frame = tk.Frame(self, bg = "black", height = 300)
        self.status_frame.pack (expand = True, fill = "both")

        self.main_menu = MainMenu(self.content_frame, self)

